/** App.css – plain CSS (no unknown at-rules).
 * Tailwind je skonfigurovaný v index.css; toto sú len komponenty/utility tohto App.
 */

@keyframes pulse-glow {
  0%, 100% {
    box-shadow: 0 0 5px rgba(6, 182, 212, 0.9), 0 0 10px rgba(6, 182, 212, 0.7), 0 0 15px rgba(6, 182, 212, 0.5);
  }

  50% {
    box-shadow: 0 0 10px rgba(6, 182, 212, 0.9), 0 0 20px rgba(6, 182, 212, 0.7), 0 0 30px rgba(6, 182, 212, 0.5);
  }
}

@keyframes scanline {
  0% {
    transform: translateY(-100%);
  }

  100% {
    transform: translateY(100vh);
  }
}

@keyframes flicker {
  0% {
    opacity: 1;
  }

  50% {
    opacity: 0.7;
  }

  100% {
    opacity: 1;
  }
}

@keyframes float {
  0%, 100% {
    transform: translateY(0px);
  }

  50% {
    transform: translateY(-10px);
  }
}

@keyframes glitch {
  0%, 100% {
    clip-path: inset(0 0 0 0);
  }

  20% {
    clip-path: inset(10% 0 80% 0);
  }

  40% {
    clip-path: inset(30% 0 60% 0);
  }

  60% {
    clip-path: inset(50% 0 40% 0);
  }

  80% {
    clip-path: inset(70% 0 20% 0);
  }
}

* {
  border-color: #1E293B;
}

html {
  scroll-behavior: smooth;
}

::-moz-selection {
  color: #000000;
}

::selection {
  color: #000000;
}

/* components */

.btn-cyber {
  position: relative;
  display: inline-block;
  padding: 0.75rem 1.5rem;
  font-family: var(--font-mono, monospace);
  font-size: 0.875rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  background-color: #0f172a;
  border: 2px solid #06b6d4;
  color: #22d3ee;
  transition: all 0.3s ease;
}

.btn-cyber:hover {
  background-color: rgba(6, 182, 212, 0.06);
  box-shadow: 0 0 25px rgba(6, 182, 212, 0.25);
}

.btn-cyber:focus {
  outline: none;
  box-shadow: 0 0 0 3px rgba(6, 182, 212, 0.25);
}

.btn-cyber-pink {
  border-color: #fb7185;
  color: #fb7185;
}

.btn-cyber-pink:hover {
  background-color: rgba(244, 63, 94, 0.06);
  box-shadow: 0 0 25px rgba(244, 63, 94, 0.25);
}

.btn-cyber-green {
  border-color: #34d399;
  color: #34d399;
}

.btn-cyber-green:hover {
  background-color: rgba(16, 185, 129, 0.06);
  box-shadow: 0 0 25px rgba(16, 185, 129, 0.25);
}

.btn-cyber-purple {
  border-color: #a78bfa;
  color: #a78bfa;
}

.btn-cyber-purple:hover {
  background-color: rgba(139, 92, 246, 0.06);
}

.card-cyber {
  position: relative;
  padding: 1.5rem;
  background-color: #020617;
  border: 1px solid #1e293b;
  backdrop-filter: blur(4px);
  transition: all 0.5s ease;
}

.card-cyber:hover {
  border-color: #22d3ee;
  box-shadow: 0 0 25px rgba(6, 182, 212, 0.25);
}

.card-cyber::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(to bottom right, rgba(6, 182, 212, 0.05), transparent, rgba(99, 102, 241, 0.05));
  opacity: 0;
  transition: opacity 0.5s ease;
}

.card-cyber:hover::before {
  opacity: 1;
}

.input-cyber {
  width: 100%;
  padding: 0.75rem 1rem;
  background-color: #0f172a;
  border: 2px solid #334155;
  color: #f1f5f9;
  font-family: var(--font-mono, monospace);
  font-size: 0.875rem;
  transition: all 0.3s ease;
}

.input-cyber::-moz-placeholder {
  color: #64748b;
}

.input-cyber::placeholder {
  color: #64748b;
}

.input-cyber:focus {
  outline: none;
  border-color: #22d3ee;
  box-shadow: 0 0 25px rgba(6, 182, 212, 0.25);
}

.glow-text-cyan {
  color: #22d3ee;
  text-shadow: 0 0 5px rgba(6, 182, 212, 0.8), 0 0 10px rgba(6, 182, 212, 0.5);
}

.glow-text-pink {
  color: #fb7185;
  text-shadow: 0 0 5px rgba(244, 63, 94, 0.8), 0 0 10px rgba(244, 63, 94, 0.5);
}

.scanline-overlay::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: repeating-linear-gradient(
    0deg,
    transparent,
    transparent 2px,
    rgba(0, 0, 0, 0.13) 2px,
    rgba(0, 0, 0, 0.13) 4px
  );
  animation: scanline 3s linear infinite;
}

.glitch-text {
  position: relative;
  font-family: var(--font-mono, monospace);
}

.glitch-text::before,
.glitch-text::after {
  content: attr(data-text);
  position: absolute;
  inset: 0;
}

.glitch-text::before {
  color: #22d3ee;
  clip-path: rect(0, 900px, 0, 0);
  animation: glitch 2s ease-in-out infinite;
}

.glitch-text::after {
  color: #fb7185;
  clip-path: rect(0, 900px, 0, 0);
  animation: glitch 2s ease-in-out infinite;
  animation-delay: 0.1s;
}

/* utilities */

.text-balance {
  text-wrap: balance;
}

.animate-pulse-glow {
  animation: pulse-glow 2s ease-in-out infinite;
}

.animate-float {
  animation: float 6s ease-in-out infinite;
}

.animate-flicker {
  animation: flicker 0.15s ease-in-out infinite alternate;
}
